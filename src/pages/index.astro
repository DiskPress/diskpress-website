---
import '../styles/global.css';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#f2efe8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={canonicalURL} />
		<title>{SITE_TITLE}</title>
		<meta name="description" content={SITE_DESCRIPTION} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={SITE_TITLE} />
		<meta property="og:description" content={SITE_DESCRIPTION} />
		<meta property="og:url" content={canonicalURL} />
		<meta name="twitter:card" content="summary" />
		<!-- Privacy-friendly analytics by Plausible -->
		<script
			is:inline
			async
			data-domain="diskpress.app"
			src="https://analytics.diskpress.app/js/script.outbound-links.tagged-events.js"
		></script>
		<script is:inline>
			window.plausible = window.plausible || function () {
				(plausible.q = plausible.q || []).push(arguments);
			};
			plausible.init = plausible.init || function (options) {
				plausible.o = options || {};
			};
			plausible.init();
		</script>
	</head>
	<body>
		<main>
			<p class="status">In development</p>
			<h1>DiskPress</h1>
			<p class="intro">
				A macOS app made by
				<a href="https://reverseeverything.com/?utm_source=diskpress.app">Ighor July</a>.
			</p>
			<a class="more-apps" href="https://reverseeverything.com/apps/?utm_source=diskpress.app">
				More apps
				<svg aria-hidden="true" viewBox="0 0 16 16">
					<path d="M3 8h10M9 4l4 4-4 4" />
				</svg>
			</a>
		</main>
	</body>
</html>
