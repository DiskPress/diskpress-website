---
import '../styles/global.css';
import '../styles/content.css';
import DownloadLink from '../components/DownloadLink.astro';
import AppearanceControl from '../components/AppearanceControl.astro';
import { SITE_DESCRIPTION, DEVELOPER_URL, BLOG_URL, MORE_APPS_URL } from '../consts';
interface Props { title?: string; description?: string; noindex?: boolean; }
const { title = 'DiskPress - More room. Same files.', description = SITE_DESCRIPTION, noindex = false } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const navigation = [
  { label: 'How it works', href: '/#how-it-works' },
  { label: 'CLI guide', href: '/cli/' },
  { label: 'FAQ', href: '/faq/' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f9fafb" />
    <link rel="icon" type="image/x-icon" sizes="16x16 32x32 48x48 64x64" href="/favicon.ico?v=2" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=2" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=2" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg?v=2" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=2" />
    {!noindex && <link rel="canonical" href={canonicalURL} />}
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="DiskPress" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary" />
    <noscript><style>.appearance-control { display: none; }</style></noscript>
    <script is:inline>
      (() => {
        const systemTheme = window.matchMedia('(prefers-color-scheme: dark)');
        function syncAppearanceControl() {
          const preference = document.documentElement.dataset.appearance;
          const label = document.getElementById('appearance-label');
          if (label) label.textContent = { system: 'System', light: 'Light', dark: 'Dark' }[preference];
          document.querySelectorAll('[data-appearance-choice]').forEach(choice => {
            choice.setAttribute('aria-checked', String(choice.dataset.appearanceChoice === preference));
          });
        }
        function updateAppearance(preference) {
          const dark = preference === 'dark' || (preference === 'system' && systemTheme.matches);
          document.documentElement.dataset.theme = dark ? 'dark' : 'light';
          document.documentElement.dataset.appearance = preference;
          document.querySelector('meta[name="theme-color"]').content = dark ? '#111413' : '#f9fafb';
          syncAppearanceControl();
        }
        let preference = 'system';
        try { preference = localStorage.getItem('diskpress-appearance') || 'system'; } catch {}
        if (!['light', 'dark', 'system'].includes(preference)) preference = 'system';
        updateAppearance(preference);
        const followSystemTheme = () => updateAppearance(document.documentElement.dataset.appearance);
        if (systemTheme.addEventListener) systemTheme.addEventListener('change', followSystemTheme);
        else systemTheme.addListener(followSystemTheme);
        document.addEventListener('diskpress:appearance-ready', syncAppearanceControl);

        function closeAppearanceMenu(restoreFocus = false) {
          const menu = document.getElementById('appearance-menu');
          const trigger = document.getElementById('appearance');
          if (!menu || menu.hidden) return;
          const focusWasInMenu = menu.contains(document.activeElement);
          menu.hidden = true;
          trigger.setAttribute('aria-expanded', 'false');
          if (restoreFocus || focusWasInMenu) trigger.focus();
        }
        function positionAppearanceMenu() {
          const menu = document.getElementById('appearance-menu');
          if (!menu || menu.hidden) return;
          menu.style.removeProperty('--menu-shift');
          const bounds = menu.getBoundingClientRect();
          const shift = Math.max(12 - bounds.left, Math.min(0, document.documentElement.clientWidth - 12 - bounds.right));
          menu.style.setProperty('--menu-shift', `${shift}px`);
        }
        function openAppearanceMenu(edge) {
          const menu = document.getElementById('appearance-menu');
          document.getElementById('appearance').setAttribute('aria-expanded', 'true');
          const mobileMenu = document.querySelector('.mobile-nav');
          if (mobileMenu) mobileMenu.open = false;
          menu.hidden = false;
          positionAppearanceMenu();
          const choices = [...menu.querySelectorAll('[data-appearance-choice]')];
          const choice = edge === 'first' ? choices[0] : edge === 'last' ? choices[choices.length - 1] : choices.find(choice => choice.getAttribute('aria-checked') === 'true');
          choice?.focus();
        }
        document.addEventListener('click', event => {
          const target = event.target instanceof Element ? event.target : null;
          if (target?.closest('#appearance')) {
            const menu = document.getElementById('appearance-menu');
            if (menu.hidden) openAppearanceMenu();
            else closeAppearanceMenu(true);
          } else if (target?.closest('[data-appearance-choice]')) {
            const preference = target.closest('[data-appearance-choice]').dataset.appearanceChoice;
            updateAppearance(preference);
            try { localStorage.setItem('diskpress-appearance', preference); } catch {}
            closeAppearanceMenu(true);
          } else if (!target?.closest('.appearance-control')) closeAppearanceMenu();
        });
        document.addEventListener('keydown', event => {
          const target = event.target instanceof Element ? event.target : null;
          if (target?.id === 'appearance' && ['ArrowDown', 'ArrowUp'].includes(event.key)) {
            event.preventDefault();
            openAppearanceMenu(event.key === 'ArrowDown' ? 'first' : 'last');
            return;
          }
          const menu = document.getElementById('appearance-menu');
          if (!menu || menu.hidden || !target?.closest('.appearance-control')) return;
          if (event.key === 'Escape' || event.key === 'Tab') {
            if (event.key === 'Escape') event.preventDefault();
            closeAppearanceMenu(true);
            return;
          }
          const choices = [...menu.querySelectorAll('[data-appearance-choice]')];
          const index = choices.indexOf(target.closest('[data-appearance-choice]'));
          let next;
          if (event.key === 'ArrowDown') next = choices[(index + 1) % choices.length];
          else if (event.key === 'ArrowUp') next = choices[(index + choices.length - 1) % choices.length];
          else if (event.key === 'Home') next = choices[0];
          else if (event.key === 'End') next = choices[choices.length - 1];
          else if (event.key.length === 1 && !event.ctrlKey && !event.metaKey && !event.altKey) next = choices.find(choice => choice.dataset.appearanceChoice.startsWith(event.key.toLowerCase()));
          if (next) { event.preventDefault(); next.focus(); }
        });
        document.addEventListener('focusin', event => {
          if (!(event.target instanceof Element) || !event.target.closest('.appearance-control')) closeAppearanceMenu();
        });
        window.addEventListener('resize', positionAppearanceMenu);

        // Delegate before parsing the body so copy controls never wait for a deferred script.
        const copyTimers = new WeakMap();
        document.addEventListener('click', async event => {
          const button = event.target instanceof Element ? event.target.closest('[data-copy-target]') : null;
          if (!button) return;
          const code = document.getElementById(button.dataset.copyTarget);
          const status = button.closest('.code-block')?.querySelector('.copy-status');
          if (!code) return;
          try {
            await navigator.clipboard.writeText(code.textContent || '');
            button.textContent = 'Copied';
            if (status) { status.classList.add('sr-only'); status.textContent = 'Copied to clipboard.'; }
            clearTimeout(copyTimers.get(button));
            copyTimers.set(button, setTimeout(() => { button.textContent = 'Copy'; }, 2000));
          } catch {
            const range = document.createRange();
            range.selectNodeContents(code);
            const selection = window.getSelection();
            selection?.removeAllRanges();
            selection?.addRange(range);
            if (status) { status.classList.remove('sr-only'); status.textContent = 'Command selected. Use your keyboard or context menu to copy.'; }
          }
        });
        document.documentElement.dataset.enhanced = '';
      })();
    </script>
    <!-- Privacy-friendly analytics by Plausible -->
    <script is:inline async data-domain="diskpress.app" src="https://analytics.diskpress.app/js/script.outbound-links.tagged-events.js"></script>
    <script is:inline>
      window.plausible = window.plausible || function () { (plausible.q = plausible.q || []).push(arguments); };
      plausible.init = plausible.init || function (options) { plausible.o = options || {}; };
      plausible.init();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="header-inner wrap">
        <a href="/" class="brand" aria-label="DiskPress home"><img src="/favicon.svg" width="36" height="36" alt="" /><span>DiskPress</span></a>
        <nav class="desktop-nav" aria-label="Main navigation">
          {navigation.map(({ label, href }) => <a href={href} aria-current={Astro.url.pathname === href ? 'page' : undefined}>{label}</a>)}
        </nav>
        <div class="header-actions">
          <AppearanceControl />
          <DownloadLink compact />
          <details class="mobile-nav">
            <summary aria-label="Navigation menu"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg></summary>
            <nav aria-label="Mobile navigation">{navigation.map(({ label, href }) => <a href={href}>{label}</a>)}<a href="/support/" aria-current={Astro.url.pathname === '/support/' ? 'page' : undefined}>Support</a></nav>
          </details>
        </div>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div class="footer-brand"><a href="/" class="brand"><img src="/favicon.svg" width="32" height="32" alt="" /><span>DiskPress</span></a><p>More room for what you keep.</p><p class="fine">A Mac app by <a href={DEVELOPER_URL}>Ighor July</a>.</p></div>
        <nav aria-label="Product links"><h2>Explore</h2><a href="/#how-it-works">How it works</a><a href="/cli/">CLI guide</a><a href="/faq/">FAQ</a></nav>
        <nav aria-label="Help and legal"><h2>Help</h2><a href="/support/" aria-current={Astro.url.pathname === '/support/' ? 'page' : undefined}>Contact support</a><a href="/privacy-policy/">Privacy policy</a><a href="/terms-of-service/">Terms of service</a></nav>
        <nav aria-label="Developer links"><h2>Made by <a href={DEVELOPER_URL}>Ighor July</a></h2><a href={MORE_APPS_URL}>More Mac apps</a><a href={BLOG_URL}>Reverse Everything blog</a><span class="fine">Copyright {new Date().getFullYear()} <a href={DEVELOPER_URL}>Ighor July</a></span></nav>
      </div>
    </footer>
    <script>
      const mobileMenu = document.querySelector<HTMLDetailsElement>('.mobile-nav');
      mobileMenu?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => { mobileMenu.open = false; }));
      document.addEventListener('keydown', event => { if (event.key === 'Escape' && mobileMenu?.open) { mobileMenu.open = false; mobileMenu.querySelector('summary')?.focus(); } });
      document.addEventListener('click', event => { if (mobileMenu?.open && event.target instanceof Node && !mobileMenu.contains(event.target)) mobileMenu.open = false; });
    </script>
  </body>
</html>
