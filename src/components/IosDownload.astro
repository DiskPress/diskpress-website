---
import DownloadLink from './DownloadLink.astro';
import { IOS_APP_STORE_AVAILABLE } from '../consts';
---
<div class="ios-availability">
  <DownloadLink platform="ios" />
  <p class="fine">{IOS_APP_STORE_AVAILABLE ? 'For iPhone and iPad. See the listing for pricing and compatibility.' : 'For iPhone and iPad. Awaiting App Store approval, not yet available to download.'}</p>
</div>
