---
import { APP_STORE_AVAILABLE, APP_STORE_URL } from '../consts';
interface Props { compact?: boolean; shortLabel?: boolean; }
const { compact = false, shortLabel = false } = Astro.props;
---
{APP_STORE_AVAILABLE ? (
  <a class:list={['download-link', { compact }]} href={APP_STORE_URL} aria-label={shortLabel ? 'Download DiskPress on the Mac App Store' : undefined}>
    <span>{shortLabel ? 'Mac App Store' : compact ? 'Get DiskPress' : 'Download on the Mac App Store'}</span>
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg>
  </a>
) : (
  <span class:list={['release-status', { compact }]}>
    {compact ? <>Available soon<span class="sr-only"> on the Mac App Store</span></> : 'Available soon on the Mac App Store'}
  </span>
)}
