---
import DocumentLayout from '../layouts/DocumentLayout.astro';
import { APP_STORE_URL, IOS_APP_STORE_URL } from '../consts';

const sections = [
  { id: 'v1-1-1', label: 'Mac 1.1.1' },
  { id: 'ios-v1-0-2', label: 'iOS 1.0.2' },
  { id: 'ios-v1-0-1', label: 'iOS 1.0.1' },
  { id: 'ios-v1-0-0', label: 'iOS 1.0.0' },
  { id: 'v1-0-8', label: 'Mac 1.0.8' },
  { id: 'v1-0-7', label: 'Mac 1.0.7' },
  { id: 'v1-0-6', label: 'Mac 1.0.6' },
  { id: 'v1-0-5', label: 'Mac 1.0.5' },
  { id: 'v1-0-4', label: 'Mac 1.0.4' },
  { id: 'v1-0-3', label: 'Mac 1.0.3' },
  { id: 'v1-0-2', label: 'Mac 1.0.2' },
  { id: 'v1-0-1', label: 'Mac 1.0.1' },
  { id: 'v1-0-0', label: 'Mac 1.0.0' },
];
---
<DocumentLayout title="Changelog" eyebrow="DiskPress changelog" heading="What's new in DiskPress" description="Release notes for DiskPress for Mac and DiskPress for Files for iPhone and iPad." sections={sections}>
  <section id="v1-1-1" class="changelog-release">
    <div class="changelog-release-heading"><p class="eyebrow">Latest Mac release</p><h2>DiskPress v1.1.1</h2><p class="fine">Mac - <time datetime="2026-10-19T00:53:12Z">October 18, 2026</time></p><p>More reliable saved locations and savings reporting, with faster optimization of large folders.</p></div>
    <ul class="changelog-list">
      <li>Fixed an issue that could incorrectly mark saved locations as invalid after restarting your Mac or reconnecting a drive.</li>
      <li>Fixed an issue where the savings panel could remain at zero after optimization</li>
      <li>Improved optimization speed for large folders.</li>
    </ul>
    <p class="fine">Release notes from the <a href={APP_STORE_URL}>Mac App Store</a>.</p>
  </section>
  <section id="ios-v1-0-2" class="changelog-release">
    <div class="changelog-release-heading"><h2>DiskPress for Files v1.0.2</h2><p class="fine">iPhone and iPad - <time datetime="2026-10-18T13:39:04Z">October 18, 2026</time></p><p>Apple Shortcuts support, background optimization on iOS 27 or later, and clearer progress.</p></div>
    <ul class="changelog-list">
      <li>Added Apple Shortcuts actions to list saved folders and start optimization using their configured modes and exclusions on iOS 16 or later.</li>
      <li>Added background optimization of saved folders and subfolders on iOS 27 or later, including paths within previously authorized locations.</li>
      <li>Added Compress File Copy on iOS 27 or later. Pass a file from another action or a shortcut enabled in the share sheet and receive a separate compressed copy, leaving the original untouched.</li>
      <li>Added an Automation section to saved folders, with Add Location Shortcut, folder path copying and setup guidance.</li>
      <li>Added help for creating, sharing and running shortcuts, including compatibility and compression limitations.</li>
      <li>Updated loading icons and popover dismissal handling.</li>
      <li>Improved progress feedback for large selections, with live file counts and clearer status messages.</li>
    </ul>
    <p class="fine">Release notes from the <a href={IOS_APP_STORE_URL}>App Store</a>.</p>
  </section>
  <section id="ios-v1-0-1" class="changelog-release">
    <div class="changelog-release-heading"><h2>DiskPress for Files v1.0.1</h2><p class="fine">iPhone and iPad - <time datetime="2026-10-17T14:11:19Z">October 17, 2026</time></p><p>More languages, improved recovery, and a more adaptable iPad interface.</p></div>
    <ul class="changelog-list">
      <li>Added German, Ukrainian, Spanish, Latin American Spanish, Simplified Chinese and Traditional Chinese.</li>
      <li>Improved recovery of interrupted compression and deduplication operations when storage identifiers change.</li>
      <li>Updated iPad navigation with native tabs and a sidebar.</li>
      <li>Improved interface adaptation to changing screen sizes.</li>
      <li>Preserved entered text and keyboard focus during navigation layout changes.</li>
      <li>Improved share-sheet positioning when rotating or resizing.</li>
      <li>Improved regional formatting for numbers, percentages and durations.</li>
    </ul>
    <p class="fine">Release notes from the <a href={IOS_APP_STORE_URL}>App Store</a>.</p>
  </section>
  <section id="ios-v1-0-0" class="changelog-release">
    <div class="changelog-release-heading"><h2>DiskPress for Files v1.0.0</h2><p class="fine">iPhone and iPad - <time datetime="2026-10-15T15:21:31Z">October 15, 2026</time></p><p>Initial release of DiskPress for Files for iPhone and iPad.</p></div>
    <p>Apple did not publish release notes for this initial version.</p>
    <p class="fine">Release history from the <a href={IOS_APP_STORE_URL}>App Store</a>.</p>
  </section>
  <section id="v1-0-8" class="changelog-release">
    <div class="changelog-release-heading"><h2>DiskPress v1.0.8</h2><p class="fine">Mac - <time datetime="2026-10-03T20:03:36Z">October 3, 2026</time></p><p>Faster large-folder optimization, clearer results, and more reliable scanning and recovery.</p></div>
    <ul class="changelog-list">
      <li>Faster optimization of large folders, especially when files are already compressed.</li>
      <li>Removed unnecessary repeat folder scans after successful optimization.</li>
      <li>Corrected scan counters and misleading time estimates while counting files.</li>
      <li>Simplified optimization summaries, with convenient buttons to open Activity, Locations, or Settings.</li>
      <li>Activity now explains why files in saved locations were left unchanged.</li>
      <li>Improved recovery messages and cancellation of runs waiting for recovery.</li>
      <li>Fixed a scan stall in Wine bottles and other folders containing symbolic links.</li>
      <li>Updated interface wording and translations.</li>
    </ul>
    <p class="fine">Release notes from the <a href={APP_STORE_URL}>Mac App Store</a>.</p>
  </section>
  <section id="v1-0-7" class="changelog-release">
    <div class="changelog-release-heading"><p class="eyebrow">Latest release</p><h2>DiskPress v1.0.7</h2><p class="fine"><time datetime="2026-09-29">September 29, 2026</time></p><p>Faster folder scans and fewer background rescans, with savings updated during optimization.</p></div>
    <ul class="changelog-list">
      <li>Fixed severe scanning slowdowns in folders containing many files.</li>
      <li>Background monitoring now skips unnecessary scans when saved locations haven't changed.</li>
      <li>Savings now update during optimization instead of separate background rescans, reducing CPU and battery use.</li>
    </ul>
    <p class="fine">Release notes from the <a href={APP_STORE_URL}>Mac App Store</a>.</p>
  </section>
  <section id="v1-0-6" class="changelog-release">
    <div class="changelog-release-heading"><p class="eyebrow">Latest release</p><h2>DiskPress v1.0.6</h2><p class="fine"><time datetime="2026-09-28">September 28, 2026</time></p><p>Better handling of sparse files, clearer startup messages, and lower idle CPU usage.</p></div>
    <ul class="changelog-list">
      <li>Sparse files are now skipped during compression and deduplication to preserve their existing space savings and avoid unnecessary processing.</li>
      <li>Added clearer scan results explaining why sparse files are left unchanged.</li>
      <li>Improved startup messages when another copy of DiskPress is running or its application data cannot be accessed.</li>
      <li>Fixed excessive CPU usage while idle or displaying operation results.</li>
    </ul>
    <p class="fine">Release notes from the <a href={APP_STORE_URL}>Mac App Store</a>.</p>
  </section>
  <section id="v1-0-5" class="changelog-release">
    <div class="changelog-release-heading"><p class="eyebrow">Latest release</p><h2>DiskPress v1.0.5</h2><p class="fine"><time datetime="2026-09-25">September 25, 2026</time></p><p>Faster compression, scanning, and deduplication, with quicker optimization completion.</p></div>
    <ul class="changelog-list">
      <li>Faster compression, especially for folders containing many small files.</li>
      <li>Faster scanning and deduplication.</li>
      <li>Less time spent saving results and finishing an optimization.</li>
      <li>More efficient parallel compression in Fastest mode.</li>
    </ul>
    <p class="fine">Release notes from the <a href={APP_STORE_URL}>Mac App Store</a>.</p>
  </section>
  <section id="v1-0-4" class="changelog-release">
    <div class="changelog-release-heading"><p class="eyebrow">Latest release</p><h2>DiskPress v1.0.4</h2><p class="fine"><time datetime="2026-09-24">September 24, 2026</time></p><p>Faster compression, smarter CPU use, and smoother handling of active files.</p></div>
    <ul class="changelog-list">
      <li>Lower memory use for large-folder optimizations.</li>
      <li>Faster deduplication by reusing the results of the current scan.</li>
      <li>Live file counts make duplicate-discovery progress easier to follow.</li>
      <li>Cancelling deduplication preserves work already completed.</li>
      <li>Corrected savings for overlapping saved folders, including parent and child folders.</li>
      <li>More reliable handling when files change or disappear mid-optimization.</li>
      <li>Quicker compression when processing several files in one folder.</li>
      <li>Fastest mode adapts to the Mac's available performance cores.</li>
      <li>Low CPU mode limits sustained processor load on large files.</li>
      <li>Database files and their journals are now excluded by default.</li>
      <li>Edits from other apps are preserved with fewer unnecessary recovery prompts.</li>
      <li>Unreadable or read-only files are skipped without needless attention alerts.</li>
      <li>Corrected savings accounting when access to saved folders is refreshed mid-optimization.</li>
      <li>File group editing is unavailable when every group is already excluded.</li>
    </ul>
    <p class="fine">Based on the <a href={APP_STORE_URL}>Mac App Store</a> release notes.</p>
  </section>
  <section id="v1-0-3" class="changelog-release">
    <div class="changelog-release-heading"><p class="eyebrow">Latest release</p><h2>DiskPress v1.0.3</h2><p class="fine"><time datetime="2026-09-23">September 23, 2026</time></p><p>Lower memory use, faster deduplication, and clearer progress.</p></div>
    <ul class="changelog-list">
      <li>Optimizing large folders now uses less memory.</li>
      <li>Duplicate checks run faster by carrying scan findings through the same optimization.</li>
      <li>Duplicate discovery now shows live file counts and clearer progress.</li>
      <li>Cancelling deduplication is smoother and keeps work that has already finished.</li>
      <li>Corrected savings calculations for overlapping saved locations, such as a folder and one of its subfolders.</li>
      <li>More reliable processing when a file is modified or removed during an optimization.</li>
    </ul>
    <p class="fine">Based on the <a href={APP_STORE_URL}>Mac App Store</a> release notes.</p>
  </section>
  <section id="v1-0-2" class="changelog-release">
    <div class="changelog-release-heading"><p class="eyebrow">Latest release</p><h2>DiskPress v1.0.2</h2><p class="fine"><time datetime="2026-09-21">September 21, 2026</time></p><p>Faster repeat optimizations, more control, and smoother background operation.</p></div>
    <ul class="changelog-list">
      <li>Faster repeat optimizations with cached duplicate checks and compression results.</li>
      <li>Added the option to skip deduplication during an optimization.</li>
      <li>Saved locations can now wait until a linked app is closed before optimizing.</li>
      <li>Automatic monitoring stays enabled across restarts and starts quietly at login.</li>
      <li>DiskPress can stay in the menu bar for manual optimization with monitoring off.</li>
      <li>Fixed conflicting monitoring statuses and menu actions.</li>
      <li>Clearer progress reporting, including file counts and explanations between stages.</li>
      <li>Fixed cases where progress became inaccessible or appeared stuck.</li>
      <li>Savings rescans no longer compete with active optimization.</li>
      <li>Added Ukrainian, Chinese, Spanish, and German localizations.</li>
    </ul>
    <p class="fine">Release notes from the <a href={APP_STORE_URL}>Mac App Store</a>.</p>
  </section>
  <section id="v1-0-1" class="changelog-release">
    <div class="changelog-release-heading"><p class="eyebrow">Latest release</p><h2>DiskPress v1.0.1</h2><p>More compatibility, safer recovery, clearer measurements, and smoother everyday control.</p></div>
    <ul class="changelog-list">
      <li>Added support for macOS 27 Golden Gate.</li>
      <li>Added a Linked App option for saved locations. Optimization skips these locations while the selected app is running, including manual, automatic, and CLI operations.</li>
      <li>Fixed Show Progress becoming unavailable during automatic optimization and transitions between stages.</li>
      <li>Improved switching to menu bar mode and handling repeated Close or Quit commands.</li>
      <li>Fixed a sandbox permissions issue that incorrectly skipped eligible files with <code>File metadata cannot be preserved</code>.</li>
      <li>Improved automatic recovery so affected files can be preserved and skipped while other files continue optimizing.</li>
      <li>Fixed a persistent recovery loop involving tiny files that already used no allocated storage.</li>
      <li>Preserved last known location sizes and savings when a rescan cannot finish, instead of displaying zero. Temporary scan failures now retry automatically.</li>
      <li>Excluded DiskPress temporary and recovery files from savings measurements.</li>
      <li>Updated CLI statistics to include linked apps and distinguish outdated measurements from missing data.</li>
      <li>Added the Storage Saver Duo bundle link to Help &amp; About and updated the App Archiver tile with its app icon.</li>
      <li>Improved Locations table sizing and column alignment. Optimization titles and subtitles now stay vertically centered beside the app logo.</li>
    </ul>
  </section>
  <section id="v1-0-0" class="changelog-release">
    <div class="changelog-release-heading"><h2>DiskPress v1.0.0</h2><p class="fine">Mac - <time datetime="2026-09-12T12:23:14Z">September 12, 2026</time></p><p>Initial release of DiskPress for Mac.</p></div>
    <p>Apple did not publish release notes for this initial version.</p>
    <p class="fine">Release history from the <a href={APP_STORE_URL}>Mac App Store</a>.</p>
  </section>
</DocumentLayout>
